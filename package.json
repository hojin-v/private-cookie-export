{
  "name": "private-cookie-export",
  "version": "0.3.2",
  "private": true,
  "type": "module",
  "description": "사생활 보호 탭의 쿠키를 내보내는 Firefox 확장",
  "engines": { "node": ">=20" },
  "scripts": {
    "test": "node --test test/*.test.js",
    "lint": "addons-linter --warnings-as-errors extension",
    "browser-test": "node scripts/browser-test.js",
    "android-contract": "python3 scripts/android-contract.py",
    "build": "python3 scripts/build.py",
    "verify-release": "python3 scripts/build.py --verify",
    "check": "npm test && npm run lint && npm run build && npm run verify-release"
  },
  "devDependencies": { "addons-linter": "10.14.0" }
}
