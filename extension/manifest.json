{
  "manifest_version": 3,
  "name": "Private Cookie Export",
  "version": "0.3.6",
  "default_locale": "en",
  "description": "__MSG_extensionDescription__",
  "permissions": ["activeTab", "cookies"],
  "optional_host_permissions": ["https://*/*"],
  "background": { "scripts": ["background.js"], "type": "module" },
  "action": { "default_title": "Private Cookie Export", "default_popup": "popup.html", "default_icon": "icon.svg" },
  "icons": { "48": "icon.svg", "96": "icon.svg" },
  "content_security_policy": {
    "extension_pages": "default-src 'none'; script-src 'self'; style-src 'self'; img-src 'self'; connect-src 'none'; object-src 'none'; base-uri 'none'; form-action 'none'"
  },
  "browser_specific_settings": {
    "gecko": {
      "id": "private-cookie-export@ive.codes",
      "strict_min_version": "140.0",
      "data_collection_permissions": { "required": ["authenticationInfo"] }
    },
    "gecko_android": { "strict_min_version": "155.0" }
  }
}
